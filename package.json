{
  "name": "atoll-ui",
  "version": "0.1.0",
  "description": "A morphing island for notifications, promises and background tasks. For React, or no framework at all.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/atoll.global.js",
  "jsdelivr": "./dist/atoll.global.js",
  "typesVersions": {
    "*": {
      "vanilla": [
        "./dist/vanilla.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/emit-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "react",
    "notifications",
    "toast",
    "island",
    "dynamic-island",
    "promise",
    "progress",
    "upload",
    "background-tasks"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "author": "Michael Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michaell14/atoll.git"
  },
  "homepage": "https://github.com/Michaell14/atoll#readme",
  "bugs": {
    "url": "https://github.com/Michaell14/atoll/issues"
  }
}
